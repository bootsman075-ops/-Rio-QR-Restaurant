# Kopieer dit bestand naar .env.local en vul de waarden in.
# .env.local wordt NIET in git opgenomen. Zet hier nooit echte sleutels in.

# Publieke URL van de app (gebruikt om QR-code-links op te bouwen)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Dashboard > Project Settings > Data API (URL) en > API Keys
# Project-URL, bv. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (begint met sb_publishable_) — veilig voor de browser, RLS geldt
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (begint met sb_secret_) — ALLEEN server-side, omzeilt RLS.
# Nooit prefixen met NEXT_PUBLIC_ en nooit delen.
SUPABASE_SECRET_KEY=

# Personeelsdashboard (/staff/login). Gebruik lange, verschillende wachtwoorden.
# Personeel: tafelverzoeken, reserveringen, gerechten wijzigen en beschikbaarheid.
STAFF_DASHBOARD_PASSWORD=
# Manager (optioneel): daarnaast volledig menubeheer (toevoegen, verwijderen,
# volgorde, categorieën). Leeg = er is geen managerlogin.
MANAGER_DASHBOARD_PASSWORD=
