# Kopieer dit bestand naar .env.local en vul de waarden in.
# .env.local wordt NIET in git opgenomen. Zet hier nooit echte sleutels in.

# Publieke URL van de app (gebruikt om QR-code-links op te bouwen)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — te vinden in het Supabase-dashboard onder Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Alleen server-side gebruiken; nooit prefixen met NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
